{
  "name": "adminbr",
  "version": "1.0.0",
  "description": "MyloNex Admin Backend API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:db": "tsx test/database-smoke.ts",
    "postbuild": "node tools/copy-runtime.mjs",
    "audit:backend": "tsx tools/backend-audit.ts",
    "db:repair-admin": "tsx tools/apply-admin-schema.ts --apply",
    "worker:rfq": "tsx src/modules/rfqs/notifications/worker.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.2.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

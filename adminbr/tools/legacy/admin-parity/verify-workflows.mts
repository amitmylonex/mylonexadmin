 // Simulate accepted requester decisions locally; no buyer server action or authenticated UI is invoked.
 await prisma.communicationRequestResponse.update({where:{id:response.id},data:{status:'ACCEPTED_BY_BUYER',buyerDecision:'accepted',buyerDecisionAt:new Date()}});await prisma.sample.update({where:{id:sample.id},data:{status:'accepted_by_buyer',buyerDecision:'accepted',buyerDecisionAt:new Date()}});
 const q=listQuerySchema.parse({search:run});assert.ok((await orders.accepted('production',q)).orders.some(o=>o.id===response.id));assert.ok((await orders.accepted('sampling',listQuerySchema.parse({search:`SAMPLE-${run}`}))).orders.some(o=>o.id===sample.id));
 const deliveries=await Promise.all([orders.delivered('production',response.id,actor.id),orders.delivered('production',response.id,actor.id)]);assert.equal(deliveries.reduce((n,r)=>n+r.count,0),1);assert.equal((await orders.delivered('sampling',sample.id,actor.id)).count,1);assert.equal((await orders.delivered('sampling',sample.id,actor.id)).count,0);pass('accepted-source views and concurrent delivery guards preserve accepted decisions');
 const order=await prisma.order.create({data:{orderNumber:`ORDER-${run}`,orderType:'production',responseId:response.id,buyerId:buyer.id,supplierId,trackingNumber:'LOCAL-TRACK',milestones:{create:{title:'Synthetic milestone',status:'PENDING_PAYMENT'}}}});const master:any=await orders.legacy(listQuerySchema.parse({search:`ORDER-${run}`}));assert.equal(master.orders[0].response.requestMatch.communicationRequest.fabricName,request.fabricName);assert.equal(master.orders[0].milestones.length,1);pass('Order Master View preserves platform records, fabric, supplier/buyer and milestones');
 const buyerPage:any=await buyers.list(listQuerySchema.parse({search:buyer.email}));assert.equal(buyerPage.buyers[0].id,buyer.id);assert.equal(buyerPage.buyers[0].engagementStatus,'converted');assert.equal(buyerPage.buyers[0].acceptedOrderCount,2);assert.ok((await buyers.detail(buyer.id,'production',listQuerySchema.parse({})))?.activity.some(r=>r.id===response.id));assert.equal(await buyers.detail(supplier.id,'rfqs',listQuerySchema.parse({})),null);pass('buyer counts use accepted quote/sample sources; derived engagement and role-scoped detail are correct');
 const metrics=await dashboard();assert.ok(metrics.platformMetrics.totalInquiries>=1);assert.ok(metrics.platformMetrics.totalResponses>=1);assert.ok(Number.isFinite(metrics.platformMetrics.avgResponseTimeHours));pass('original dashboard aggregate SQL and current moderation metrics execute');
 old=(await import('../../../../../mylonex-nextjs/src/lib/db.ts')).db;const oldQuote=await old.communicationRequestResponse.findUniqueOrThrow({where:{id:response.id}});assert.equal(Number(oldQuote.supplierOriginalPrice),100);assert.equal(oldQuote.status,'ACCEPTED_BY_BUYER');assert.ok(oldQuote.deliveredAt);const oldSample=await old.sample.findUniqueOrThrow({where:{id:sample.id}});assert.equal(Number(oldSample.quoteSampleCostInr),25.5);assert.ok(oldSample.deliveredAt);const oldOrder=await old.order.findUniqueOrThrow({where:{id:order.id}});assert.equal(oldOrder.trackingNumber,'LOCAL-TRACK');pass('actual old-project Prisma/pg adapter reads persisted quote, sample and order outcomes');
 fs.writeFileSync('docs/complete-admin-test-db-results.json',JSON.stringify({status:'PASS',target:'127.0.0.1:55489/schema_repair_test',syntheticOnly:true,externalMessagesSent:0,checks},null,2));
}catch(error){fs.writeFileSync('docs/complete-admin-test-db-results.json',JSON.stringify({status:'FAIL',target:'127.0.0.1:55489/schema_repair_test',checks,error:error instanceof Error?error.message:String(error)},null,2));throw error;}finally{await prisma.$disconnect();if(old)await old.$disconnect();}

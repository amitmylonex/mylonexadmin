 const request=await prisma.communicationRequest.create({data:{buyerId:buyer.id,requesterRole:'BUYER',requestType:'quote',buyerMessage:'Synthetic local request',fabricName:`Parity cotton ${run}`,quantity:1000,deliveryPincode:'395001',rfqNumber:`PARITY-${run}`,autoRoutedTo:'manual',routingReason:'Local synthetic test',anonymizedBuyerReference:'LOCAL-BUYER',specPayload:{composition:'100% Cotton',gsm:180}}});

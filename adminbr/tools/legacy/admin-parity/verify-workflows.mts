 await transitionSupplier(supplierId,{expectedCurrentStatus:'SUSPENDED',nextStatus:'APPROVED',reason:'Synthetic supplier reactivated'});
 const forwarded=await rfqs.decide(manual.match.id,'forward',{note:'Synthetic review'},actor.id);assert.equal(forwarded.notification?.state,'not-dispatched');
 await assert.rejects(rfqs.decide(manual.match.id,'reject',{},actor.id));pass('RFQ decisions use pending compare-and-set; stale rejection cannot overwrite forward');
 const detail:any=await rfqs.detail(request.id,{});assert.equal(detail.rfq.matches.length,1);assert.equal(detail.rfq.matches[0].adminReviewedByUserId,actor.id);pass('paged RFQ detail reads review actor, supplier and match state');
 const meta={version:1,submittedVia:'whatsapp',source:'FLOW',priceBasis:'Ex-mill',priceValidity:'48 hours',priceValidUntil:new Date(Date.now()+48*3600000).toISOString(),moqPerColour:500,sampleStatus:'AVAILABLE',sampleYardageM:10,sampleLeadTimeDays:7,samplingPrice:0,remarks:'Synthetic sample terms',submittedAt:new Date().toISOString(),inboundMessageId:`private-${run}`};
 const response=await prisma.communicationRequestResponse.create({data:{requestMatchId:manual.match.id,supplierId,price:100,leadTimeDays:5,moq:500,additionalNotes:JSON.stringify(meta)}});
 const reviews=await Promise.allSettled([quotes.decide(response.id,'approve',{edits:{price:120,leadTimeDays:7,additionalNotes:'must not overwrite'}},actor.id),quotes.decide(response.id,'approve',{edits:{price:125,leadTimeDays:8}},actor.id)]);
 assert.equal(reviews.filter(r=>r.status==='fulfilled').length,1);const saved=await prisma.communicationRequestResponse.findUniqueOrThrow({where:{id:response.id}});assert.equal(saved.supplierOriginalPrice?.toNumber(),100);assert.equal(saved.additionalNotes,JSON.stringify(meta));assert.equal(saved.status,'APPROVED_FOR_REQUESTER');pass('concurrent quote approval releases once, snapshots original price and preserves WhatsApp validity');
 await assert.rejects(quotes.decide(response.id,'reject',{},actor.id));
 const tracking=await getRfqTracking({q:`PARITY-${run}`,page:1,pageSize:25});assert.equal(tracking.ok,true);if(tracking.ok){assert.equal(tracking.data.rows.length,1);assert.equal(tracking.data.summary.quoted,1);assert.equal(tracking.data.summary.read,0);}const timeline=await getRfqTrackingDetail(request.id,{});assert.equal(timeline.ok,true);assert.ok(!JSON.stringify(timeline).includes(meta.inboundMessageId));pass('tracking SQL search/counts/detail project actual quote evidence without private metadata IDs');
 const sampleData={buyerId:buyer.id,supplierId,sampleType:'fabric',fabricName:'Synthetic sample cotton',fabricType:'cotton',composition:'100% Cotton',gsm:180,quantityMeters:2.5,deliveryAddress:'Synthetic test address',pincode:'395001',specialInstructions:'Synthetic only',specPayload:{}};
 const sample=await prisma.sample.create({data:{...sampleData,sampleNumber:`SAMPLE-${run}`}});const payload={sampleRatePerMeter:10.2,courierCostInr:7.5,deliveryTimeline:'7 days',quoteValidUntil:new Date(Date.now()+86400000).toISOString(),internalNotes:'Synthetic quote'};
 await samples.quote(sample.id,payload,actor.id);const quoted=await prisma.sample.findUniqueOrThrow({where:{id:sample.id}});assert.equal(quoted.quoteSampleCostInr?.toString(),'25.5');assert.equal(quoted.status,'quoted');await assert.rejects(samples.quote(sample.id,payload,actor.id));pass('sample quote computes rate × quantity, persists and rejects repeated release');
